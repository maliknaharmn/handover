# URL dan publishable key untuk proyek Supabase nonproduksi.
# Keduanya boleh dipakai di browser, tetapi akses data tetap wajib dibatasi RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hanya di server untuk mengirim undangan dan menjalankan cron. Jangan pakai NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
